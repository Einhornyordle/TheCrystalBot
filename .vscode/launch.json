                "NODE_ENV": "development"
            },
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false
        },
        {
            "type": "bun",
            "internalConsoleOptions": "openOnSessionStart",
            "request": "launch",
            "name": "Deploy Commands (production)",
            "program": "deploy-commands.js",
            "env": {
                "NODE_ENV": "production"
            },
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false
